<?xml version="1.0" encoding="utf-8"?>
<!--
  IvanaFin: point the launcher icon and TV banner at IvanaFin's own PNGs (fresh resource
  names, so launchers that cache by resource - like Fire TV's - load the new picture).
  The banner is a plain drawable and is declared on the launcher activity too: Fire OS's
  launcher otherwise draws the square icon on a grey tile instead of the full 16:9 picture.
  Generated by branding/make-icons.ps1.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:icon="@mipmap/ivanafin_launcher_wide"
        android:roundIcon="@mipmap/ivanafin_launcher_wide"
        android:banner="@drawable/ivanafin_firetv_banner"
        tools:replace="android:icon,android:banner">
        <activity
            android:name="com.github.damontecres.wholphin.MainActivity"
            android:banner="@drawable/ivanafin_firetv_banner" />
    </application>
</manifest>
